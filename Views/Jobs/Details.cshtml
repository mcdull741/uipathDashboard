@model UiPathJobManager.Models.Job
@{
    ViewData["Title"] = $"Job #{Model.Id} 详情";
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item"><a asp-controller="Job" asp-action="Index">Job 列表</a></li>
        <li class="breadcrumb-item active">Job #@Model.Id</li>
    </ol>
</nav>

<div class="card shadow-sm">
    <div class="card-header bg-light d-flex justify-content-between align-items-center flex-wrap">
        <h5 class="mb-0"><i class="bi bi-card-list"></i> Job #@Model.Id 详情</h5>
        <div class="d-flex gap-2">
            @if (User.IsInRole("Admin"))
            {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-primary">
                    <i class="bi bi-pencil"></i> 编辑
                </a>
            }
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> 返回列表
            </a>
        </div>
    </div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Job ID</dt>
            <dd class="col-sm-9"><code>@Model.Id</code></dd>

            <dt class="col-sm-3">流程名</dt>
            <dd class="col-sm-9">@Model.ProcessName</dd>

            <dt class="col-sm-3">状态</dt>
            <dd class="col-sm-9"><span class="badge bg-@Model.StateBadgeClass fs-6">@Model.State</span></dd>

            <dt class="col-sm-3">机器人</dt>
            <dd class="col-sm-9">@Model.RobotName</dd>

            <dt class="col-sm-3">机器</dt>
            <dd class="col-sm-9">@Model.MachineName</dd>

            <dt class="col-sm-3">开始时间</dt>
            <dd class="col-sm-9">@Model.StartTime.ToString("yyyy-MM-dd HH:mm:ss")</dd>

            <dt class="col-sm-3">结束时间</dt>
            <dd class="col-sm-9">@(Model.EndTime?.ToString("yyyy-MM-dd HH:mm:ss") ?? "--")</dd>

            <dt class="col-sm-3">耗时</dt>
            <dd class="col-sm-9">@(Model.Duration?.ToString(@"hh\:mm\:ss") ?? "--")</dd>

            <dt class="col-sm-3">Key</dt>
            <dd class="col-sm-9"><code>@Model.Key</code></dd>

            <dt class="col-sm-3">Release</dt>
            <dd class="col-sm-9">@Model.ReleaseName v@(Model.ReleaseVersion)</dd>

            <dt class="col-sm-3">输入参数</dt>
            <dd class="col-sm-9"><pre class="bg-light p-2 rounded small mb-0">@Model.InputArguments</pre></dd>

            <dt class="col-sm-3">输出参数</dt>
            <dd class="col-sm-9"><pre class="bg-light p-2 rounded small mb-0">@Model.OutputArguments</pre></dd>

            @if (!string.IsNullOrEmpty(Model.FaultReason))
            {
                <dt class="col-sm-3 text-danger">错误信息</dt>
                <dd class="col-sm-9"><pre class="bg-danger-subtle text-danger p-2 rounded small mb-0">@Model.FaultReason</pre></dd>
            }

            <dt class="col-sm-3">备注</dt>
            <dd class="col-sm-9">@(string.IsNullOrEmpty(Model.Remark) ? "<span class='text-muted'>无</span>" : Model.Remark)</dd>

            <dt class="col-sm-3">标签</dt>
            <dd class="col-sm-9">
                @if (!string.IsNullOrEmpty(Model.Tag))
                {
                    <span class="badge bg-info">@Model.Tag</span>
                }
                else
                {
                    <span class="text-muted">无</span>
                }
            </dd>

            <dt class="col-sm-3">本地更新时间</dt>
            <dd class="col-sm-9 text-muted small">@Model.UpdatedAt.ToString("yyyy-MM-dd HH:mm:ss")</dd>
        </dl>
    </div>
</div>