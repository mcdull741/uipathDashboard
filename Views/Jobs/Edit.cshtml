@model UiPathJobManager.Models.JobEditViewModel
@{
    ViewData["Title"] = $"编辑 Job #{Model.Id}";
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item"><a asp-controller="Job" asp-action="Index">Job 列表</a></li>
        <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@Model.Id">详情</a></li>
        <li class="breadcrumb-item active">编辑</li>
    </ol>
</nav>

<div class="card shadow-sm">
    <div class="card-header bg-light">
        <h5 class="mb-0"><i class="bi bi-pencil-square"></i> 编辑 Job #@Model.Id</h5>
    </div>
    <div class="card-body">
        <form asp-action="Edit" method="post" class="row g-3">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            <div class="col-md-6">
                <label class="form-label">流程名</label>
                <input class="form-control" value="@Model.ProcessName" disabled readonly />
            </div>
            <div class="col-md-6">
                <label class="form-label">状态</label>
                <input class="form-control" value="@Model.State" disabled readonly />
            </div>
            <div class="col-md-6">
                <label class="form-label">开始时间</label>
                <input class="form-control" value="@Model.StartTime.ToString("yyyy-MM-dd HH:mm:ss")" disabled readonly />
            </div>
            <div class="col-md-6">
                <label class="form-label">结束时间</label>
                <input class="form-control" value="@(Model.EndTime?.ToString("yyyy-MM-dd HH:mm:ss") ?? "")" disabled readonly />
            </div>
            <div class="col-md-6">
                <label class="form-label">机器人</label>
                <input class="form-control" value="@Model.RobotName" disabled readonly />
            </div>
            <div class="col-md-6">
                <label class="form-label">机器</label>
                <input class="form-control" value="@Model.MachineName" disabled readonly />
            </div>

            <div class="col-12"><hr class="my-2" /><h6 class="text-muted mb-0">本地可编辑字段</h6></div>

            <div class="col-md-8">
                <label asp-for="Remark" class="form-label"></label>
                <textarea asp-for="Remark" class="form-control" rows="3" placeholder="管理员备注..."></textarea>
                <span asp-validation-for="Remark" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Tag" class="form-label"></label>
                <input asp-for="Tag" class="form-control" placeholder="如: 紧急 / 重要 / 已复核" />
                <span asp-validation-for="Tag" class="text-danger small"></span>
            </div>

            <div class="col-12 d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-lg"></i> 保存
                </button>
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
                    <i class="bi bi-x-lg"></i> 取消
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}